#!/bin/sh
# Conventional commits -- the PR title check enforces the same on squash.
set -e
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+'
if ! grep -qE "$pattern" "$1"; then
  echo "commit-msg: message must follow Conventional Commits" >&2
  echo "  e.g. feat(agenda): rank overdue tasks by decay" >&2
  exit 1
fi
