<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background layer, as a vector so it stays crisp at
     every launcher size without five more PNGs. Kept deliberately plain: the
     mark carries the identity, the gradient only gives it depth. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF5B4FD6" />
                <item android:offset="1" android:color="#FF241E63" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
