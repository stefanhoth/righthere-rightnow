<?xml version="1.0" encoding="utf-8"?>
<!-- The API 26+ launcher icon. The launcher masks these layers itself, which
     is why the foreground keeps the mark inside the 66dp safe zone and the
     background is a plain full-bleed gradient. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons, API 33+. Ignored below that. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
